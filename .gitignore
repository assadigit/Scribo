# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare / opennext
.wrangler/
.open-next/

# local cloudflare credentials (contains your API token — never commit)
.cloudflare-secrets.json

# local env / secrets — never commit
.env
.env.*
.dev.vars
.dev.vars.*
# ...but the example template IS committed
!.env.example

# production
/build
/dist

# local backups made during syncs (never commit, never push)
scribo-backup-*/
scribo-backup-*.zip
scribo-backup-*.tar*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (never commit real ones — use .env.example as template)
# (specific rules above already allow .env.example)

# design scratch / source material (kept on disk for reference, not part of
# the app build or repo)
/ideas/
/feather assets/
/jmh_typewriter/
/splendid-66/

# design source files (Photoshop) — never part of the app build
*.psd

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
