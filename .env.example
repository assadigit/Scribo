# Scribo — environment variables template
# ----------------------------------------
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# These credentials are only needed on YOUR computer (or in GitHub Secrets,
# which are already set up for automatic deploys). The website itself does
# not use them at runtime.

# Cloudflare (from https://dash.cloudflare.com/profile/api-tokens)
# Token needs: Workers Scripts (edit), D1 (edit), Workers Domain records (edit)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub (only if you use the `gh` command line tool from this folder)
GITHUB_TOKEN=

# Worker secret names (set with: npx wrangler secret put <NAME>)
# Currently NONE are set on the live worker. If Google login is enabled later,
# you would add:  GOOGLE_CLIENT_SECRET  (see README section "Google login")
